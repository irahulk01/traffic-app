{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/traffic.js": {
      "maxDuration": 30,
      "includeFiles": "src/data/monitoredRoutes.json"
    }
  },
  "routes": [
    {
      "src": "/api/traffic/usage",
      "dest": "/api/traffic.js?trafficEndpoint=usage"
    },
    {
      "src": "/api/traffic",
      "dest": "/api/traffic.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/.*",
      "status": 404
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
